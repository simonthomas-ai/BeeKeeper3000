[Unit]
Description=BeeKeeper durable local Monitor bridge
Requires=beekeeper-monitor.service beekeeper-source-api.service
After=network.target beekeeper-monitor.service beekeeper-source-api.service

[Service]
Type=simple
User=beekeeper
Group=beekeeper
WorkingDirectory=@BEEKEEPER_ROOT@
EnvironmentFile=/etc/beekeeper3000/station.env
ExecStart=@NODE@ @BEEKEEPER_ROOT@/monitor-bridge/bridge.mjs
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/beekeeper3000
LimitNOFILE=4096
TasksMax=64

[Install]
WantedBy=multi-user.target
