# Copy to /etc/beekeeper3000/camera.env and edit with sudoedit.
# Keep this file root:beekeeper and mode 0640. Never commit camera credentials.
# Use 0 or /dev/video0 for a local V4L2 camera, or an RTSP/HTTPS stream URL.
# Quote a URL if it contains spaces or shell-like characters.
BEEKEEPER_CAMERA_SOURCE=0
HORNET3000_STATION_ID=replace-with-station-pseudonym
BEEKEEPER_MODEL_MANIFEST=/var/lib/beekeeper3000/models/manifest.json
BEEKEEPER_CAMERA_OUTBOX=/var/lib/beekeeper3000/camera-outbox.sqlite3
BEEKEEPER_CAMERA_MAX_FPS=5
BEEKEEPER_CAMERA_COOLDOWN_SECONDS=30
BEEKEEPER_ONNX_THREADS=2
