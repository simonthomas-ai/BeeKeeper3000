{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simonthomas-ai/BeeKeeper3000/blob/main/network/protocol-v1.schema.json",
  "title": "BeeKeeper3000 Station Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "station_id", "observed_at", "expires_at", "event_type", "candidate_taxon", "verification_status", "signature_key_id", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 16, "maxLength": 80},
    "station_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "event_type": {"enum": ["sighting", "bearing", "nest_hypothesis", "station_heartbeat", "expert_verification"]},
    "candidate_taxon": {"enum": ["Vespa_velutina", "Vespa_crabro", "other", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verification_status": {"enum": ["unverified", "photo_reviewed", "expert_confirmed", "rejected"]},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "accuracy_m"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "accuracy_m": {"type": "number", "minimum": 0, "maximum": 100000}
      }
    },
    "bearing_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
    "bearing_sigma_deg": {"type": "number", "minimum": 0.5, "maximum": 45},
    "evidence_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "privacy_level": {"enum": ["local_only", "coarse_public", "trusted_network", "authorized_team"]},
    "signature_key_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "signature": {"type": "string", "minLength": 32, "maxLength": 256}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "bearing"}}},
      "then": {"required": ["location", "bearing_deg", "bearing_sigma_deg"]}
    },
    {
      "if": {"properties": {"event_type": {"const": "nest_hypothesis"}}},
      "then": {"required": ["location", "privacy_level"]}
    }
  ]
}
